---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Hoang Pham";
---

<BaseLayout pageTitle={pageTitle}>
  <figure class="quote">
    <blockquote>
      <p>
        "Most technology stacks have some sort of first-class artifact,
        along with tools to support creating and installing them.
        Ruby has gems,
        Java has JAR files and WAR files,
        and Python has eggs."
      </p>
    </blockquote>
    <figcaption>
      - Sam Newman, Building Microservices
    </figcaption>
  </figure>
</BaseLayout>
